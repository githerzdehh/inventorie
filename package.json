{
  "name": "inventorie",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-s prepare:ocr \"build:app {@}\" --",
    "build:app": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "prepare:ocr": "node scripts/prepare-ocr-assets.mjs",
    "android:sync": "run-s build cap:sync:android",
    "android:open": "cap open android",
    "android:apk:debug": "run-s android:sync android:assemble:debug",
    "android:assemble:debug": "cd android && ./gradlew assembleDebug",
    "cap:sync:android": "cap sync android",
    "type-check": "vue-tsc --build",
    "lint": "vue-tsc --build --force",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@mdi/font": "^7.4.47",
    "@techstark/opencv-js": "^4.12.0-release.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "dexie": "^4.4.4",
    "libphonenumber-js": "^1.13.7",
    "pinia": "^3.0.4",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0",
    "vuetify": "^4.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.10.5",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "prettier": "3.8.4",
    "sass": "^1.101.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
